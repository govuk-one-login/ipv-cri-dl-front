{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "DrivingLicence-CRI",
      "component": "ipv-cri-dl-front",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/pr-check.yml",
          "path": "$.jobs.pre-commit"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "regression"
              ]
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/pr-check.yml",
          "path": "$.jobs.tests"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "accessibility"
            },
            {
              "name": "integration",
              "purpose": [
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/pr-check.yml",
          "path": "$.jobs.browser-tests.steps[?@.name=='Browser tests']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/scan-repo.yml",
          "path": "$.jobs.sonar"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/scan-repo.yml",
          "path": "$.jobs.codeql"
        }
      ]
    }
  ]
}
